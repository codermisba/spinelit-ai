# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Local secrets (API keys) - never commit
.env

# Dataset images (too large for GitHub).
# Upload them to Google Drive for Colab instead.
dataset/data/

# Generated landmark/grading CSVs — produced fresh by prepare_spider.py.
# Do NOT track them (stale copies break the SPIDER flow).
dataset/coords_pretrain.csv
dataset/coords_vertebrae.csv
dataset/coords_rsna_improved.csv
dataset/ddd_labels.csv
dataset/longitudinal_records.csv

# ALL trained model weights stay out of Git...
checkpoints/*.pth
checkpoints/*.pt
# ...except the small fp16 inference artifact (<100 MB GitHub limit),
# exported with: python export_release.py
!checkpoints/release_model.pth
logs/*.csv
outputs/

# Gradio runtime artifacts
.gradio/

# OS files
Thumbs.db
.DS_Store
